# Culture-MAP V2 환경 설정 예시
# Liveblocks 기반 실시간 협업

# Liveblocks 설정 (필수)
# https://liveblocks.io/dashboard 에서 Secret key 발급
LIVEBLOCKS_SECRET_KEY=REDACTED

# 관리자 API 보호 (프로덕션 필수)
APP_ORIGIN=http://localhost:5173
ADMIN_API_TOKEN=change-this-admin-token

# Gemini API 설정 (AI 기능 사용 시)
# https://aistudio.google.com/apikey 에서 발급
VITE_GEMINI_API_KEY=REDACTED...

# 앱 환경
VITE_APP_ENV=development

# 개발 편의성 설정 (true 설정 시 비디오/로그인 건너뜀)
VITE_SKIP_GATE=false
