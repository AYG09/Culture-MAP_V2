# 로컬 개발용 Firebase 설정 예시
# 실제 Firebase 프로젝트 설정값으로 교체하세요

VITE_FIREBASE_API_KEY=REDACTED
VITE_FIREBASE_AUTH_DOMAIN=my-culture-analyzer.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://my-culture-analyzer-default-rtdb.firebaseio.com/
VITE_FIREBASE_PROJECT_ID=my-culture-analyzer
VITE_FIREBASE_STORAGE_BUCKET=my-culture-analyzer.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789
VITE_APP_ENV=development

# Liveblocks 설정 (실시간 협업)
# https://liveblocks.io/dashboard 에서 API 키 발급
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_dev_xxxxxxxxxxxxxxxxxxxxxxxx
