{
  "rules": {
    ".read": "root.child('authorized').child(auth.uid).exists() || root.child('publicSessions').child($sessionCode).child('isPublic').val() === true",
    ".write": "auth.uid !== null",
    "authorized": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('admins').child(auth.uid).exists()",
        ".write": "root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.isString()"
      }
    },
    "admins": {
      "$uid": {
        ".read": "root.child('admins').child(auth.uid).exists()",
        ".write": "root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.isBoolean()"
      }
    },
    "gateway": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      ".write": "root.child('admins').child(auth.uid).exists()",
      ".validate": "newData.hasChildren(['sessionCode', 'createdAt'])",
      "passwords": {
        ".read": "root.child('admins').child(auth.uid).exists()",
        ".write": "root.child('admins').child(auth.uid).exists()",
        ".indexOn": ["sessionCode", "status", "type"],
        "$passwordId": {
          ".validate": "newData.hasChildren(['password', 'sessionCode', 'createdAt', 'type', 'status', 'expiresAt']) && newData.child('expiresAt').val() > now"
        }
      },
      "sessions": {
        ".read": "root.child('admins').child(auth.uid).exists()",
        ".write": "root.child('admins').child(auth.uid).exists()",
        ".indexOn": ["isActive", "passwordId", "createdAt"],
        "$sessionId": {
          ".validate": "newData.hasChildren(['sessionCode', 'createdAt', 'host'])"
        }
      }
    },
    "sessions": {
      ".read": "auth.uid !== null || root.child('publicSessions').child($sessionCode).child('isPublic').val() === true",
      ".write": "auth.uid !== null",
      ".indexOn": ["lastActivity", "createdAt", "host"],
      "$sessionCode": {
        ".read": "auth.uid !== null || data.child('isPublic').val() === true",
        ".write": "auth.uid !== null && (data.child('host').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".indexOn": ["host", "createdAt", "lastActivity"],
        ".validate": "newData.hasChildren(['createdAt']) && (newData.child('lastActivity').val() > now - 604800000 || newData.child('host').exists())",
        "participants": {
          ".read": "$parent.child('isPublic').val() === true || auth.uid !== null",
          ".write": "auth.uid !== null && ($parent.child('host').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
          "$userId": {
            ".validate": "newData.hasChildren(['joinedAt'])"
          }
        },
        "cultureDimensions": {
          ".read": "$parent.child('isPublic').val() === true || auth.uid !== null",
          ".write": "auth.uid !== null && ($parent.child('host').val() === auth.uid || root.child('admins').child(auth.uid).exists())"
        },
        "analysis": {
          ".read": "$parent.child('isPublic').val() === true || auth.uid !== null",
          ".write": "auth.uid !== null && ($parent.child('host').val() === auth.uid || root.child('admins').child(auth.uid).exists())"
        },
        "notes": {
          "$noteId": {
            ".validate": "newData.hasChildren(['content', 'createdAt'])"
          }
        },
        "connections": {
          "$connectionId": {
            ".validate": "newData.hasChildren(['source', 'target', 'type'])"
          }
        },
        "layerState": {
          ".validate": "newData.isObject()"
        },
        "editing": {
          "$userId": {
            ".write": "auth.uid === $userId || root.child('admins').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['startTime'])"
          }
        }
      }
    },
    "publicSessions": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists()",
      ".indexOn": ["createdAt"],
      "$sessionCode": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['sessionCode', 'createdAt', 'isPublic'])"
      }
    },
    "metadata": {
      ".read": "auth.uid !== null",
      ".write": "root.child('admins').child(auth.uid).exists()",
      "lastUpdated": {
        ".validate": "newData.isNumber()"
      },
      "version": {
        ".validate": "newData.isString()"
      }
    }
  }
}
