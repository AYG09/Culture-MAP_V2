{
  "rules": {
    ".read": false,
    ".write": false,
    
    "gateway": {
      "passwords": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["sessionCode", "status", "type"],
        "$passwordId": {
          ".validate": "newData.hasChildren(['password', 'type', 'createdAt', 'expiresAt', 'status']) && newData.child('password').isString() && newData.child('createdAt').isNumber() && newData.child('expiresAt').isNumber()"
        }
      },
      "sessions": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["isActive", "passwordId", "createdAt"],
        "$sessionCode": {
          ".validate": "newData.hasChildren(['host', 'createdAt', 'isActive']) && newData.child('host').isString() && newData.child('createdAt').isNumber()"
        }
      }
    },
    
    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["lastActivity", "createdAt", "host"],
      "$sessionCode": {
        ".indexOn": ["host", "createdAt", "lastActivity"],
        ".validate": "newData.hasChildren(['createdAt']) && newData.child('createdAt').isNumber()"
      }
    },
    
    "metadata": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['lastUpdated']) && newData.child('lastUpdated').isNumber()"
    }
  }
}
